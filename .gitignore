node_modules/
dist/
build/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# ---------------------------------------------------------------------------------------
# Everything under data/ is fetched or derived, and none of it belongs in version control.
#
#   chain/blocks/   raw blocks from the public explorers. Two days is roughly 280 MB and
#                   it is a cache: deleting it costs a re-fetch, nothing more.
#   chain/*.json    the analysed window and its model output. window.json alone is ~190 MB
#                   for a two-day range, which is far past what git should carry, and it
#                   is reproducible from the blocks by one command.
#   models/         trained weights. Committing these freezes a model to whatever data it
#                   happened to see, which is the opposite of a reproducible pipeline.
#   sources.json    holds an API key when one is configured. It must never be committed.
# ---------------------------------------------------------------------------------------
data/

# Editors and operating systems
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
